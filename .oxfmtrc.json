{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "none",
  "arrowParens": "always",
  "sortImports": {},
  "sortPackageJson": false,
  "sortTailwindcss": {
    "stylesheet": "./src/index.css",
    "functions": ["cn", "cva", "clsx"]
  },
  "ignorePatterns": [".vite", "out", "dist", "pnpm-lock.yaml", "src/assets"]
}

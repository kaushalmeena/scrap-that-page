{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "react-perf",
    "jsx-a11y",
    "import",
    "unicorn",
    "vitest"
  ],
  "jsPlugins": ["oxlint-tailwindcss", "./tools/oxlint/local-plugin.mjs"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "settings": {
    "tailwindcss": {
      "entryPoint": "src/index.css"
    }
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react/exhaustive-deps": "error",
    "react/rules-of-hooks": "error",
    "react/jsx-key": "error",
    "react/no-array-index-key": "off",
    "react-perf/jsx-no-new-function-as-prop": "off",
    "react-perf/jsx-no-new-object-as-prop": "off",
    "react-perf/jsx-no-new-array-as-prop": "off",
    "react-perf/jsx-no-jsx-as-prop": "off",
    "import/no-cycle": "error",
    "import/no-unassigned-import": "off",
    "unicorn/no-array-sort": "off",
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_"
      }
    ],
    "jsx-a11y/prefer-tag-over-role": "off",
    "vitest/require-mock-type-parameters": "off",
    "vitest/require-to-throw-message": "off",
    "import/no-named-as-default": "off",
    "unicorn/require-module-specifiers": "off",
    "unicorn/no-array-reverse": "off",
    "no-await-in-loop": "off",
    "unicorn/consistent-function-scoping": "off",
    "local/no-inline-jsx-function": "error",
    "tailwindcss/no-conflicting-classes": "error",
    "tailwindcss/no-contradicting-variants": "error",
    "tailwindcss/no-duplicate-classes": "error",
    "tailwindcss/no-dynamic-classes": "error",
    "tailwindcss/no-unknown-classes": "error",
    "tailwindcss/enforce-canonical": "error",
    "tailwindcss/enforce-negative-arbitrary-values": "error",
    "tailwindcss/no-deprecated-classes": "error",
    "tailwindcss/no-unnecessary-arbitrary-value": "error",
    "tailwindcss/prefer-theme-tokens": "error",
    "tailwindcss/consistent-variant-order": "error",
    "tailwindcss/enforce-consistent-important-position": "error",
    "tailwindcss/enforce-consistent-variable-syntax": "error",
    "tailwindcss/enforce-shorthand": "error",
    "tailwindcss/no-unnecessary-whitespace": "error",
    "tailwindcss/no-hardcoded-colors": "warn",
    "tailwindcss/prefer-scale-token": "error"
  },
  "ignorePatterns": [".vite", "out", "dist", "node_modules", "src/assets"],
  "overrides": [
    {
      "files": ["src/main/**", "src/preload/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/app/*",
                  "@/components/*",
                  "@/features/*",
                  "@/lib/*",
                  "@/database/*",
                  "@/index*"
                ],
                "message": "Main and preload run in Node: import only from @/types, @/constants and @/utils."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/types/**", "src/constants/**", "src/utils/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/app/*",
                  "@/components/*",
                  "@/features/*",
                  "@/lib/*",
                  "@/database/*",
                  "@/index*"
                ],
                "message": "Shared code is imported by every process: keep it free of renderer modules."
              }
            ]
          }
        ]
      }
    }
  ]
}
